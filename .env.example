# Copy this file to .env for local development. Values here are local placeholders.
# Docker Compose uses the db service hostname internally; local Node uses localhost.
POSTGRES_USER=worknoon
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=worknoon
DATABASE_URL=postgresql://worknoon:local_dev_password@localhost:5432/worknoon?schema=public

# Backend API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public browser URL for the backend API. This value is bundled into the web build.
VITE_API_URL=http://localhost:3000
